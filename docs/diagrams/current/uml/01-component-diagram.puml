@startuml GupShup Cafe - Component Diagram (Current State)

' PlantUML version 1.2025.x
!theme plain
skinparam componentStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

' Modern color scheme with stereotypes
skinparam component {
    BackgroundColor<<frontend>> #E3F2FD
    BorderColor<<frontend>> #1976D2
    BackgroundColor<<backend>> #E8F5E9
    BorderColor<<backend>> #388E3C
    BackgroundColor<<ai>> #FFF9C4
    BorderColor<<ai>> #F57C00
    BackgroundColor<<infrastructure>> #ECEFF1
    BorderColor<<infrastructure>> #546E7A
    FontColor #263238
}

title GupShup Cafe - Component Architecture (Testing Branch)

package "Client Layer (client/)" {
    component "React 18 + Vite" as ReactApp <<frontend>> {
        component "Pages" as Pages {
            component "LoginPage" as Login
            component "SignupPage" as Signup
            component "LobbyPage" as Lobby
            component "RoomLobbyPage" as RoomLobby
            component "RoundtablePage" as Roundtable
            component "BroadcastTestPage" as BroadcastTest
            component "AudioTestPage" as AudioTest
        }
        
        component "Contexts" as Contexts {
            component "AuthContext" as Auth
            component "SocketContext" as Socket
            component "AudioContext" as Audio
        }
        
        component "Components" as Components {
            component "UI Components" as UIComps
            component "Feedback Components" as FeedbackComps
            component "Common Components" as CommonComps
        }
        
        component "Utils" as Utils {
            component "participantHelpers" as PartHelpers
            component "constants" as Constants
        }
        
        Pages -[hidden]down- Contexts
        Contexts -[hidden]down- Components
        Components -[hidden]down- Utils
    }
    
    component "WebRTC Engine" as WebRTC <<frontend>> {
        component "Audio Manager" as AudioMgr
        component "Peer Connections" as PeerConn
        component "Speech-to-Text" as STT
    }
    
    component "Socket.io Client" as SocketClient <<frontend>>
    
    note right of ReactApp
        Key Pages:
        - LoginPage/SignupPage (Auth)
        - LobbyPage (Room Discovery)
        - RoomLobbyPage (Room Waiting)
        - RoundtablePage (Discussion)
        - BroadcastTestPage (Testing)
        
        Key Contexts:
        - AuthContext (User Auth)
        - SocketContext (Socket.io)
        - AudioContext (WebRTC + Audio)
        
        New Features:
        - Anonymous names
        - Room sharing via URLs
        - Participant helpers
        - Speech-to-text integration
    end note
}

package "Backend Layer (server_py/)" {
    component "FastAPI Server" as FastAPI <<backend>> {
        component "REST Routes" as RESTRoutes {
            component "User Routes" as UserRoutes
            component "Room Routes" as RoomRoutes
            component "Participant Routes" as PartRoutes
            component "Feedback Routes" as FeedbackRoutes
            component "Transcript Routes" as TranscriptRoutes
            component "Agent Routes" as AgentRoutes
        }
        
        component "Socket Handlers" as SocketHandlers {
            component "Room Events" as RoomEvents
            component "WebRTC Signaling" as WebRTCSignal
            component "Agent Events" as AgentEvents
        }
    }
    
    component "Services Layer" as Services <<backend>> {
        component "User Service" as UserSvc
        component "Room Service" as RoomSvc
        component "Participant Service" as PartSvc
        component "Feedback Service" as FeedbackSvc
        component "Transcript Service" as TranscriptSvc
        component "Agent Service" as AgentSvc
    }
    
    component "Room Manager" as RoomMgr <<backend>> {
        component "Room State" as RoomState
        component "Turn Management" as TurnMgmt
        component "Timer System" as TimerSys
    }
    
    component "Database Service" as DBService <<backend>> {
        component "SQLite" as SQLite
        component "CRUD Operations" as CRUD
        component "Migrations" as Migrations
    }
    
    component "Pydantic Models" as Models <<backend>> {
        component "User Models" as UserModels
        component "Room Models" as RoomModels
        component "Participant Models" as PartModels
        component "Feedback Models" as FeedbackModels
        component "Transcript Models" as TranscriptModels
        component "Agent Models" as AgentModels
    }
    
    note right of FastAPI
        Running on:
        - Python 3.11 
        - Port 3003
        - FastAPI + Socket.io
        
        Complete CRUD APIs:
        - Users (signup, login, profile)
        - Rooms (create, list, update, delete)
        - Participants (join, ready, mute)
        - Feedback (instant, comprehensive)
        - Transcripts (create, process)
        - Agents (facilitator, feedback)
    end note
}

package "AI Layer (Strands SDK + MCP)" {
    component "Multi-Agent System" as Orchestrator <<ai>> {
        component "AWSStrandsOrchestrator" as AgentCoord
        component "AgentCore Runtime" as AgentCore
        component "Strands Model Adapter" as ModelAdapter
    }
    
    component "EnglishFeedbackAgent" as EnglishAgent <<ai>> {
        component "Grammar Analysis" as Grammar
        component "Vocabulary Scorer" as Vocab
        component "Fluency Assessment" as Fluency
        component "CEFR Leveling" as CEFR
    }
    
    component "DebateFacilitatorAgent" as FacilitatorAgent <<ai>> {
        component "Turn Controller" as TurnCtrl
        component "Topic Guidance" as TopicGuide
        component "Discussion Moderation" as Moderation
        component "Response Generation" as RespGen
    }
    
    component "MCP Tools" as MCPTools <<ai>> {
        component "Debate Room Tools" as DebateTools {
            component "topic_selector" as TopicSel
            component "get_next_speaker" as NextSpeaker
            component "validate_turn" as ValidateTurn
            component "analyze_discussion" as AnalyzeDisc
        }
        
        component "Grammar Tools" as GrammarTools {
            component "check_grammar" as CheckGrammar
            component "analyze_vocabulary" as AnalyzeVocab
            component "detect_fillers" as DetectFillers
            component "analyze_structure" as AnalyzeStruct
        }
    }
    
    component "MCP Infrastructure" as MCPInfra <<ai>> {
        component "Debate Tools Server" as DebateServer
        component "Grammar Tools Server" as GrammarServer
        component "MCPToolsManager" as MCPManager
    }
    
    note right of Orchestrator
        Agent System:
        - Strands SDK integration
        - Pluggable LLM providers
        - MCP tools support
        - AgentCore wrapper
        
        Feedback Modes:
        - Instant (2-3 sec)
        - Comprehensive (detailed)
        
        Facilitator Features:
        - Turn management
        - AI speaking turns
        - TTS response generation
    end note
    
    note right of MCPTools
        MCP Servers:
        - Port 8000: Debate Tools
        - Port 8001: Grammar Tools
        
        Protocol:
        - Streamable HTTP transport
        - JSON-RPC methods
        - Tool registration
    end note
}

package "Infrastructure Layer" {
    component "AWS Amplify" as Amplify <<infrastructure>> {
        component "CloudFront CDN" as CDN
        component "S3 Static Hosting" as S3
        component "CI/CD Pipeline" as CICD
    }
    
    component "AWS Fargate/ECS" as Fargate <<infrastructure>> {
        component "Task Definition" as TaskDef
        component "Service Auto-scaling" as AutoScale
        component "ALB" as ALB
    }
    
    component "EFS Storage" as EFS <<infrastructure>> {
        component "SQLite Database" as EFSDb
        component "Shared Storage" as SharedStorage
    }
    
    component "LLM Providers" as LLMProviders <<infrastructure>> {
        component "AWS Bedrock" as Bedrock {
            component "Claude 3 (Prod)" as Claude
            component "Amazon Nova (Prod)" as Nova
        }
        
        component "Google Gemini" as Gemini {
            note bottom
                Development only
                Free tier
            end note
        }
    }
    
    component "AWS AgentCore" as AgentCore <<infrastructure>> {
        component "Runtime Environment" as Runtime
        component "Identity & Permissions" as IAM
        component "Internet Access" as Internet
    }
    
    note right of LLMProviders
        Pluggable Architecture:
        - Set LLM_PROVIDER env var
        - Switch: bedrock | gemini
        - Model adapter layer
        - Strands SDK integration
    end note
}

' Client to Backend connections
ReactApp --> FastAPI : "REST API\n(HTTPS)"
SocketClient --> SocketHandlers : "WebSocket\n(Socket.io)"
WebRTC --> WebRTCSignal : "Signaling\n(SDP/ICE)"
STT --> SocketHandlers : "Transcripts\n(transcript-received)"

' Backend internal connections
FastAPI --> Services : "Business Logic"
Services --> Models : "Data Validation"
Services --> DBService : "Data Persistence"
SocketHandlers --> RoomMgr : "State Updates"
RoomMgr --> Services : "Service Calls"

' Backend to AI connections
FastAPI --> Orchestrator : "Feedback Requests"
SocketHandlers --> AgentSvc : "Agent Interactions"
Orchestrator --> EnglishAgent : "English Analysis"
Orchestrator --> FacilitatorAgent : "Facilitation"
EnglishAgent --> MCPTools : "Use MCP Tools"
FacilitatorAgent --> MCPTools : "Use MCP Tools"

' MCP Infrastructure
MCPManager --> DebateServer : "HTTP Transport"
MCPManager --> GrammarServer : "HTTP Transport"
Orchestrator --> MCPManager : "MCP Client"

' AI to LLM Providers
ModelAdapter --> Bedrock : "Production"
ModelAdapter --> Gemini : "Development"
EnglishAgent --> ModelAdapter : "LLM Inference"
FacilitatorAgent --> ModelAdapter : "LLM Inference"

' Infrastructure connections
Orchestrator --> AgentCore : "Wrapped Runtime"
AgentCore --> Runtime : "Manages Lifecycle"
AgentCore --> IAM : "Identity & Access"
AgentCore --> Internet : "API Access"

ReactApp --> Amplify : "Deployed On"
FastAPI --> Fargate : "Runs On"
Amplify --> CDN : "Distributed Via"
DBService --> EFS : "Persistent Storage"

legend right
    |<back:LightBlue>   </back>| Frontend Components (client/) |
    |<back:LightGreen>   </back>| Backend Components (server_py/) |
    |<back:LightYellow>   </back>| AI/LLM Components |
    |<back:LightGray>   </back>| Infrastructure Components |
endlegend

@enduml
