@startuml GupShup Cafe - Room State Management (Current State)

' PlantUML version 1.2025.x
!theme plain
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam state {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    StartColor #388E3C
    EndColor #D32F2F
    ArrowColor #546E7A
}

title GupShup Cafe - Room State Management (Testing Branch)

[*] --> WAITING : Room created

state WAITING {
  [*] --> WaitingForParticipants
  
  WaitingForParticipants : **Entry**: Initialize room
  WaitingForParticipants : - Set max_participants (default 6)
  WaitingForParticipants : - Assign topic and category
  WaitingForParticipants : - Generate room_id (UUID)
  WaitingForParticipants : - Create in database
  WaitingForParticipants : - Status = WAITING
  WaitingForParticipants : **Exit**: Room visible in lobby
  
  WaitingForParticipants --> CheckingReadiness : Participant joins
  
  CheckingReadiness : **Entry**: Add participant
  CheckingReadiness : - Create Participant record in DB
  CheckingReadiness : - Assign anonymous_name
  CheckingReadiness : - Set avatar_color
  CheckingReadiness : - Set turn_order
  CheckingReadiness : - is_ready = false
  CheckingReadiness : - Save to database
  CheckingReadiness : **Exit**: Emit participants-update
  
  CheckingReadiness --> CheckingReadiness : Another joins
  CheckingReadiness --> CheckingReadiness : Participant toggles ready
  CheckingReadiness --> ReadyToStart : All ready & min met
  
  ReadyToStart : **Entry**: Auto-start conditions met
  ReadyToStart : - all_ready() = true
  ReadyToStart : - participant_count >= 1 (configurable)
  ReadyToStart : - Audio setup complete
  ReadyToStart : **Exit**: Emit discussion-started
  
  note right of WaitingForParticipants
    **Room Discovery:**
    - List via GET /rooms/waiting
    - Join via room_id or share URL
    - Anonymous name input modal
    
    **Constraints:**
    - Min participants: 1 (configurable)
    - Max participants: 6 (default)
    - Room ID: UUID
  end note
  
  note right of CheckingReadiness
    **Participant Features:**
    - Anonymous names with suggestions
    - Avatar colors for UI
    - Campus/location tracking
    - Starting CEFR level
    - Socket connection tracking
    
    **Ready Check:**
    - Update via PATCH /participants/{id}
    - Socket event: user-ready
    - Database persistence
  end note
}

WAITING --> IN_PROGRESS : Auto-start when ready
note on link
  **Trigger:** All participants ready
  AND minimum count met
  
  **Actions:**
  - Update room status in DB
  - Create facilitator agent
  - Create English feedback agent
  - Initialize turn timer
end note

state IN_PROGRESS {
  [*] --> InitializingDiscussion
  
  InitializingDiscussion : **Entry**: Setup discussion
  InitializingDiscussion : - current_round = 1
  InitializingDiscussion : - current_speaker_index = 0
  InitializingDiscussion : - rounds_completed = 0
  InitializingDiscussion : - Create AI agents (facilitator + feedback)
  InitializingDiscussion : - Update room: started_at timestamp
  InitializingDiscussion : - Status = IN_PROGRESS in DB
  InitializingDiscussion : **Exit**: Emit discussion-started
  
  InitializingDiscussion --> SpeakerTurn
  
  state SpeakerTurn {
    [*] --> SelectingSpeaker
    
    SelectingSpeaker : **Entry**: Determine speaker
    SelectingSpeaker : - Check if facilitator turn
    SelectingSpeaker : - Get participant at current_speaker_index
    SelectingSpeaker : - Set participant.is_speaking = true
    SelectingSpeaker : - Update in database
    SelectingSpeaker : **Exit**: Emit turn-started & speaker-change
    
    SelectingSpeaker --> Speaking : Human participant
    SelectingSpeaker --> FacilitatorSpeaking : AI facilitator
    
    Speaking : **During**: Timer active
    Speaking : - speaking_time_per_turn seconds (default 60)
    Speaking : - Emit timer-warning at 10 seconds
    Speaking : - WebRTC audio streaming
    Speaking : - Speech-to-text transcription
    Speaking : - Save transcript to database
    Speaking : - Background: English feedback agent processing
    
    Speaking --> TranscriptProcessing : Transcription active
    
    TranscriptProcessing : **Background Task**: AI processing
    TranscriptProcessing : - EnglishFeedbackAgent analyzes
    TranscriptProcessing : - Uses MCP grammar tools
    TranscriptProcessing : - Generates instant feedback (2-3 sec)
    TranscriptProcessing : - Saves to feedback table
    TranscriptProcessing : - Emit english-feedback (private)
    
    TranscriptProcessing --> Speaking : Continue speaking
    
    FacilitatorSpeaking : **During**: AI turn
    FacilitatorSpeaking : - Generate response via Strands SDK
    FacilitatorSpeaking : - Use MCP debate room tools
    FacilitatorSpeaking : - Context: recent conversation
    FacilitatorSpeaking : - Display response with timing
    FacilitatorSpeaking : - Auto-advance after display
    
    Speaking --> TurnEnding : Timer expires
    FacilitatorSpeaking --> TurnEnding : Response complete
    
    TurnEnding : **Entry**: Clean up turn
    TurnEnding : - Set participant.is_speaking = false
    TurnEnding : - Update database
    TurnEnding : - Stop timer
    TurnEnding : - Save speaking_time_seconds
    TurnEnding : **Exit**: Emit turn-ended
    
    TurnEnding --> [*]
  }
  
  SpeakerTurn --> CheckRoundCompletion : Turn ended
  
  CheckRoundCompletion : **Decision**: All spoke?
  CheckRoundCompletion : - current_speaker_index == participants.length
  
  CheckRoundCompletion --> AdvanceSpeaker : More in round
  CheckRoundCompletion --> RoundComplete : Round finished
  
  AdvanceSpeaker : **Action**: Next speaker
  AdvanceSpeaker : - current_speaker_index++
  AdvanceSpeaker : - Update in database
  
  AdvanceSpeaker --> SpeakerTurn : Next turn
  
  RoundComplete : **Entry**: Round done
  RoundComplete : - rounds_completed++
  RoundComplete : - current_round++
  RoundComplete : - current_speaker_index = 0
  RoundComplete : - Update database
  RoundComplete : **Exit**: Emit round-complete
  
  RoundComplete --> CheckDiscussionCompletion
  
  CheckDiscussionCompletion : **Decision**: All rounds done?
  CheckDiscussionCompletion : - rounds_completed == num_rounds
  
  CheckDiscussionCompletion --> SpeakerTurn : Next round
  CheckDiscussionCompletion --> DiscussionEnding : Discussion complete
  
  DiscussionEnding : **Entry**: Finalize discussion
  DiscussionEnding : - Calculate duration_seconds
  DiscussionEnding : - Set ended_at timestamp
  DiscussionEnding : - Generate comprehensive feedback
  DiscussionEnding : - Save all feedback to database
  DiscussionEnding : - Update participant ending_cefr_level
  DiscussionEnding : **Exit**: Emit discussion-ended
  
  DiscussionEnding --> [*]
  
  note right of SpeakerTurn
    **Turn Management:**
    - TimerManager handles timing
    - RoomManager tracks state
    - Socket events for real-time updates
    
    **AI Facilitator:**
    - Appears as participant
    - Positioned after every 2-3 humans
    - Generates contextual responses
    - Uses MCP tools for analysis
    
    **Speech-to-Text:**
    - Web Speech API on client
    - Real-time transcription display
    - Confidence scores tracked
    - Saved to transcripts table
  end note
}

IN_PROGRESS --> COMPLETED : Discussion ends
note on link
  **Normal completion:**
  - All rounds finished
  - Comprehensive feedback generated
  
  **Database updates:**
  - Room: status = COMPLETED
  - Room: ended_at, duration_seconds
  - Participants: ending_cefr_level
  - Feedback: comprehensive records
end note

state COMPLETED {
  [*] --> ShowingResults
  
  ShowingResults : **Display**: Summary
  ShowingResults : - Comprehensive feedback per participant
  ShowingResults : - CEFR progress tracking
  ShowingResults : - Grammar/vocabulary/fluency scores
  ShowingResults : - Suggestions and strengths
  ShowingResults : - Next steps recommendations
  
  ShowingResults --> [*] : Navigate away
}

WAITING --> CANCELLED : Room cancelled
IN_PROGRESS --> CANCELLED : Room cancelled
note on link
  **Cancellation reasons:**
  - Host leaves before start
  - All participants disconnect
  - Timeout (no activity)
  - Manual cancellation
  
  **Cleanup:**
  - Status = CANCELLED in DB
  - Close WebRTC connections
  - Stop timers
  - Remove from active rooms
end note

state CANCELLED {
  [*] --> CleaningUp
  
  CleaningUp : **Cleanup**: Resources
  CleaningUp : - Close peer connections
  CleaningUp : - Stop all timers
  CleaningUp : - Update database
  CleaningUp : - Emit error notifications
  
  CleaningUp --> [*]
}

COMPLETED --> [*] : Room archived
CANCELLED --> [*] : Room archived

note as StateTransitions
  **State Transition Summary:**
  
  **WAITING → IN_PROGRESS:**
  - Auto-triggered when all participants ready
  - Minimum participant count met
  - Creates AI agent instances
  
  **IN_PROGRESS → COMPLETED:**
  - All rounds finished (num_rounds)
  - Comprehensive feedback generated
  - Final CEFR assessments saved
  
  **Any → CANCELLED:**
  - Timeout or disconnection
  - Manual cancellation
  - Error conditions
  
  **Key Features:**
  - In-memory state (RoomManager)
  - Database persistence (async)
  - Socket.io real-time updates
  - WebRTC audio streaming
  - AI agent integration
  - Speech-to-text processing
  - Comprehensive error handling
end note

@enduml
