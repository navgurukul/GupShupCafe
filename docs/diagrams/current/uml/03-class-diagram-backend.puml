@startuml GupShup Cafe - Backend Class Diagram (Current State)

' PlantUML version 1.2025.x
!theme plain
skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam class {
    BackgroundColor #E8F5E9
    BorderColor #388E3C
    ArrowColor #546E7A
}
skinparam package {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}

title GupShup Cafe - Backend Class Diagram (Testing Branch - server_py/)

package "FastAPI Application (main.py)" {
    class FastAPIApp {
        + app: FastAPI
        + sio: AsyncServer
        + room_manager: RoomManager
        + database: Database
        --
        + startup_event()
        + shutdown_event()
        + register_routes()
        + register_socket_handlers()
    }
}

package "API Routes (src/api/)" {
    class UserRoutes <<routes>> {
        + POST /users/signup
        + POST /users/login
        + GET /users/{user_id}
        + GET /users/
        + PATCH /users/{user_id}
        + DELETE /users/{user_id}
        + PATCH /users/cefr-level
        + PATCH /users/last-active
        + PATCH /users/password
    }
    
    class RoomRoutes <<routes>> {
        + POST /rooms/
        + GET /rooms/{room_id}
        + GET /rooms/
        + GET /rooms/waiting
        + PATCH /rooms/{room_id}
        + DELETE /rooms/{room_id}
        + POST /rooms/{room_id}/start
    }
    
    class ParticipantRoutes <<routes>> {
        + POST /participants/
        + GET /participants/{participant_id}
        + GET /participants/room/{room_id}
        + PATCH /participants/{participant_id}
        + DELETE /participants/{participant_id}
    }
    
    class FeedbackRoutes <<routes>> {
        + POST /feedback/instant
        + POST /feedback/comprehensive
        + GET /feedback/participant/{participant_id}
        + GET /feedback/room/{room_id}
        + GET /feedback/{feedback_id}
        + DELETE /feedback/{feedback_id}
    }
    
    class TranscriptRoutes <<routes>> {
        + POST /transcripts/
        + GET /transcripts/{transcript_id}
        + GET /transcripts/room/{room_id}
        + DELETE /transcripts/{transcript_id}
        + PATCH /transcripts/processing
        + PATCH /transcripts/audio-url
    }
    
    class AgentRoutes <<routes>> {
        + POST /agents/
        + GET /agents/{agent_id}
        + GET /agents/room/{room_id}/type/{type}
        + POST /agents/{agent_id}/generate-facilitator
        + DELETE /agents/{agent_id}
    }
}

package "Services Layer (src/services/)" {
    class UserService <<service>> {
        + signup(user_data)
        + login(credentials)
        + get_user(user_id)
        + list_users()
        + update_user(user_id, data)
        + delete_user(user_id)
        + update_cefr_level(user_id, level)
        + update_last_active(user_id)
        + update_password(user_id, password)
    }
    
    class RoomService <<service>> {
        + create_room(room_data)
        + get_room(room_id)
        + list_rooms()
        + list_rooms_by_status(status)
        + update_room(room_id, data)
        + delete_room(room_id)
        + start_discussion(room_id)
    }
    
    class ParticipantService <<service>> {
        + create_participant(data)
        + get_participant(participant_id)
        + list_participants_for_room(room_id)
        + update_participant(participant_id, data)
        + delete_participant(participant_id)
    }
    
    class FeedbackService <<service>> {
        + create_instant_feedback(data)
        + create_comprehensive_feedback(data)
        + list_feedback_for_participant(p_id)
        + list_feedback_for_room(room_id)
        + get_feedback(feedback_id)
        + delete_feedback(feedback_id)
    }
    
    class TranscriptService <<service>> {
        + create_transcript(data)
        + get_transcript(transcript_id)
        + list_transcripts_for_room(room_id)
        + delete_transcript(transcript_id)
        + update_transcript_processing(t_id, status)
        + update_transcript_audio_url(t_id, url)
    }
    
    class AgentService <<service>> {
        + create_agent(data)
        + get_agent(agent_id)
        + get_agents_by_type(room_id, agent_type)
        + delete_agent(agent_id)
        + generate_facilitator_turn_response(a_id, ctx)
    }
}

package "Pydantic Models (src/models/)" {
    class UserModel <<model>> {
        + user_id: str
        + name: str
        + email: str
        + current_cefr_level: CEFRLevel
        + topic_categories: List[str]
        + created_at: datetime
        + last_active: datetime
    }
    
    class RoomModel <<model>> {
        + room_id: str
        + room_name: str
        + topic_title: str
        + topic_category: str
        + cefr_level: CEFRLevel
        + status: RoomStatus
        + max_participants: int
        + speaking_time_per_turn: int
        + num_rounds: int
        + current_round: int
        + current_speaker_index: int
        + participant_count: int
        + created_by: str
        + started_at: datetime
        + ended_at: datetime
    }
    
    class ParticipantModel <<model>> {
        + participant_id: str
        + user_id: str
        + room_id: str
        + anonymous_name: str
        + avatar_color: str
        + role: ParticipantRole
        + is_ready: bool
        + is_speaking: bool
        + is_muted: bool
        + socket_id: str
        + turn_order: int
        + starting_cefr_level: CEFRLevel
        + ending_cefr_level: CEFRLevel
        + joined_at: datetime
        + left_at: datetime
        + campusOrLocation: str
        + speaking_time_seconds: int
    }
    
    class FeedbackModel <<model>> {
        + feedback_id: str
        + participant_id: str
        + room_id: str
        + feedback_type: str
        + grammar_score: float
        + vocabulary_score: float
        + fluency_score: float
        + overall_score: float
        + cefr_level: CEFRLevel
        + cefr_confidence: float
        + suggestions: List[str]
        + strengths: List[str]
        + grammar_issues: List[dict]
        + vocabulary_suggestions: List[dict]
        + agent_id: str
        + created_at: datetime
    }
    
    class TranscriptModel <<model>> {
        + transcript_id: str
        + room_id: str
        + participant_id: str
        + transcript_text: str
        + round_number: int
        + turn_order: int
        + word_count: int
        + speech_rate: float
        + is_processed: bool
        + audio_file_url: str
        + stt_confidence: float
        + timestamp: datetime
    }
    
    class AgentModel <<model>> {
        + agent_id: str
        + room_id: str
        + agent_type: AgentType
        + agent_model: str
        + status: AgentStatus
        + interactions_count: int
        + created_at: datetime
    }
    
    enum CEFRLevel {
        A0, A1, A2
        B1, B2
        C1, C2
    }
    
    enum RoomStatus {
        WAITING
        IN_PROGRESS
        COMPLETED
        CANCELLED
    }
    
    enum ParticipantRole {
        HOST
        PARTICIPANT
        LISTENER
        AGENT
    }
    
    enum AgentType {
        FACILITATOR
        FEEDBACK
        MODERATOR
    }
    
    enum AgentStatus {
        ACTIVE
        INACTIVE
        ERROR
    }
}

package "Socket Handlers (src/socket/)" {
    class SocketHandlers <<socket>> {
        + on_connect(sid, environ, auth)
        + on_disconnect(sid)
        + on_join_room(sid, data)
        + on_leave_room(sid)
        + on_user_ready(sid, data)
        + on_discussion_started(sid, data)
        + on_webrtc_offer(sid, data)
        + on_webrtc_answer(sid, data)
        + on_webrtc_ice_candidate(sid, data)
        + on_transcript_received(sid, data)
        + on_request_facilitator_response(sid, data)
        + on_get_instant_feedback(sid, data)
        + on_turn_ended(sid, data)
        + on_speaker_change(sid, data)
    }
    
    class RoomManager <<manager>> {
        - rooms: Dict[str, RoomInMemory]
        - participant_to_room: Dict[str, str]
        --
        + create_room(room_id, config)
        + join_room(room_id, participant)
        + leave_room(participant_id)
        + start_discussion(room_id)
        + get_next_speaker(room_id)
        + advance_turn(room_id)
        + end_discussion(room_id)
        + get_room_state(room_id)
        + recover_room_from_database(room_id)
    }
    
    class TimerManager <<manager>> {
        - active_timers: Dict[str, Timer]
        --
        + start_timer(room_id, duration)
        + stop_timer(room_id)
        + get_remaining_time(room_id)
        + emit_timer_warning(room_id)
        + emit_timer_expired(room_id)
    }
    
    class RoomInMemory <<model>> {
        + room_id: str
        + topic: str
        + participants: List[ParticipantInMemory]
        + status: RoomStatus
        + current_speaker_index: int
        + current_round: int
        + max_rounds: int
        + speaking_time: int
        + facilitator_agent: dict
        --
        + add_participant(participant)
        + remove_participant(socket_id)
        + set_participant_ready(socket_id, ready)
        + all_ready() : bool
        + get_current_speaker()
        + advance_to_next_speaker()
    }
}

package "Database (src/database/)" {
    class Database <<database>> {
        - db_path: str
        - db: aiosqlite.Connection
        --
        + initialize()
        + execute_transaction(operations)
        + execute_with_retry(operation)
        + migrate()
    }
    
    note right of Database
        Tables:
        - users
        - rooms
        - participants
        - transcripts
        - feedback
        - agents
        - topics
        
        Features:
        - WAL mode
        - Async operations
        - Migration system
        - Foreign key constraints
    end note
}

package "AI Agents (src/agents/)" {
    class AWSStrandsOrchestrator <<orchestrator>> {
        - model: StrandsModel
        - english_agent: EnglishFeedbackAgent
        - facilitator_agent: DebateFacilitatorAgent
        - mcp_manager: MCPToolsManager
        --
        + get_english_feedback(statements, instant, context)
        + get_facilitator_response(context)
        + activate_mcp_tools()
    }
    
    class EnglishFeedbackAgent <<agent>> {
        - model: StrandsModel
        - system_prompt: str
        --
        + analyze(transcript_data) : dict
        + instant_feedback(transcript, context) : dict
        + comprehensive_feedback(transcripts) : dict
    }
    
    class DebateFacilitatorAgent <<agent>> {
        - model: StrandsModel
        - system_prompt: str
        --
        + facilitate_turn(context) : str
        + suggest_topic_direction(statements) : str
        + moderate_discussion(context) : dict
        + generate_response(context, recent_conv) : str
    }
    
    class MCPToolsManager <<mcp>> {
        - clients: Dict[str, MCPClient]
        --
        + connect(server_name, endpoint)
        + disconnect(server_name)
        + call_tool(server, tool_name, args)
        + list_tools(server_name)
    }
}

package "LLM Infrastructure (src/llm/)" {
    class StrandsModelAdapter <<adapter>> {
        - provider: str
        - config: dict
        --
        + create_model() : StrandsModel
        + get_bedrock_model() : StrandsModel
        + get_gemini_model() : StrandsModel
    }
    
    class AIServiceManager <<singleton>> {
        - _instance: AIServiceManager
        - _llm: StrandsModel
        --
        + get_instance() : AIServiceManager
        + get_llm() : StrandsModel
        + get_model() : StrandsModel
    }
}

package "MCP Servers (src/mcp/)" {
    class DebateRoomTools <<mcp_server>> {
        + topic_selector(category, level)
        + get_next_speaker(participants, history)
        + validate_turn(speaker, time, rules)
        + analyze_discussion_pulse(transcripts)
    }
    
    class GrammarTools <<mcp_server>> {
        + check_grammar(text, level)
        + analyze_vocabulary(text, level)
        + detect_fillers(text)
        + analyze_sentence_structure(text)
    }
}

' Relationships - Routes to Services
UserRoutes --> UserService : uses
RoomRoutes --> RoomService : uses
ParticipantRoutes --> ParticipantService : uses
FeedbackRoutes --> FeedbackService : uses
TranscriptRoutes --> TranscriptService : uses
AgentRoutes --> AgentService : uses

' Services to Database
UserService --> Database : persists
RoomService --> Database : persists
ParticipantService --> Database : persists
FeedbackService --> Database : persists
TranscriptService --> Database : persists
AgentService --> Database : persists

' Services to Models
UserService ..> UserModel : validates
RoomService ..> RoomModel : validates
ParticipantService ..> ParticipantModel : validates
FeedbackService ..> FeedbackModel : validates
TranscriptService ..> TranscriptModel : validates
AgentService ..> AgentModel : validates

' Socket Handlers
SocketHandlers --> RoomManager : manages rooms
SocketHandlers --> TimerManager : manages timers
SocketHandlers --> AgentService : requests agents
SocketHandlers --> TranscriptService : saves transcripts
SocketHandlers --> FeedbackService : saves feedback
RoomManager --> RoomInMemory : maintains
RoomManager --> Database : syncs state

' AI Integration
SocketHandlers --> AWSStrandsOrchestrator : requests AI
AgentService --> AWSStrandsOrchestrator : uses
AWSStrandsOrchestrator --> EnglishFeedbackAgent : coordinates
AWSStrandsOrchestrator --> DebateFacilitatorAgent : coordinates
AWSStrandsOrchestrator --> MCPToolsManager : uses tools

EnglishFeedbackAgent --> StrandsModelAdapter : infers
DebateFacilitatorAgent --> StrandsModelAdapter : infers
AIServiceManager --> StrandsModelAdapter : provides

' MCP Infrastructure
MCPToolsManager --> DebateRoomTools : connects
MCPToolsManager --> GrammarTools : connects
EnglishFeedbackAgent ..> GrammarTools : uses
DebateFacilitatorAgent ..> DebateRoomTools : uses

' Application
FastAPIApp --> UserRoutes : registers
FastAPIApp --> RoomRoutes : registers
FastAPIApp --> ParticipantRoutes : registers
FastAPIApp --> FeedbackRoutes : registers
FastAPIApp --> TranscriptRoutes : registers
FastAPIApp --> AgentRoutes : registers
FastAPIApp --> SocketHandlers : registers
FastAPIApp --> RoomManager : initializes
FastAPIApp --> Database : initializes

note as ArchitectureNote
    **Architecture Highlights:**
    
    1. **Complete CRUD Operations**: All entities have full
       create, read, update, delete operations with Pydantic
       validation
    
    2. **MCP Tools Integration**: Grammar and debate tools 
       run as separate servers (ports 8000, 8001)
    
    3. **Pluggable LLM**: Switch between Bedrock and Gemini
       via LLM_PROVIDER environment variable
    
    4. **Strands SDK**: Multi-agent orchestration with
       AWS AgentCore wrapper
    
    5. **Real-time State**: RoomManager maintains in-memory
       state synced with database
    
    6. **Comprehensive Models**: All Pydantic models include
       Get/Create/Update/Delete/List response models
end note

@enduml
