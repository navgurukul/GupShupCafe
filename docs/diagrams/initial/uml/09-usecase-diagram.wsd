@startuml Use Case Diagram - GupShup Cafe

!define RECTANGLE class

skinparam backgroundColor #FFFFFF
skinparam actorBackgroundColor #E8F4F8
skinparam usecaseBackgroundColor #FFE6CC
skinparam packageBackgroundColor #F0F0F0

title GupShup Cafe - Use Case Diagram

left to right direction

actor "Student\n(Participant)" as Student
actor "Facilitator\n(LLM Agent)" as Agent
actor "System Admin" as Admin

rectangle "GupShup Cafe Platform" {
    
    package "Authentication" {
        usecase "UC1: Register/Login" as UC1
        usecase "UC2: Generate Anonymous Name" as UC2
    }
    
    package "Lobby Management" {
        usecase "UC3: Join Lobby" as UC3
        usecase "UC4: View Participants" as UC4
        usecase "UC5: Mark Ready" as UC5
        usecase "UC6: Leave Lobby" as UC6
        usecase "UC7: Request Audio Permission" as UC7
    }
    
    package "Discussion Room" {
        usecase "UC8: Start Discussion" as UC8
        usecase "UC9: View Discussion Topic" as UC9
        usecase "UC10: Speak During Turn" as UC10
        usecase "UC11: Listen to Others" as UC11
        usecase "UC12: Advance to Next Speaker" as UC12
        usecase "UC13: Mute/Unmute Microphone" as UC13
        usecase "UC14: View Timer" as UC14
        usecase "UC15: Change Role" as UC15
    }
    
    package "Audio Communication" {
        usecase "UC16: Initialize WebRTC" as UC16
        usecase "UC17: Transmit Audio" as UC17
        usecase "UC18: Receive Audio" as UC18
        usecase "UC19: Manage Audio Streams" as UC19
    }
    
    package "LLM Agent Facilitation" {
        usecase "UC20: Generate Topic" as UC20
        usecase "UC21: Monitor Discussion" as UC21
        usecase "UC22: Provide CEFR Feedback" as UC22
        usecase "UC23: Correct Grammar" as UC23
        usecase "UC24: Suggest Vocabulary" as UC24
        usecase "UC25: Generate Final Summary" as UC25
    }
    
    package "Analytics & Progress" {
        usecase "UC26: Track Speaking Time" as UC26
        usecase "UC27: View Session Statistics" as UC27
        usecase "UC28: View Feedback History" as UC28
        usecase "UC29: Export Analytics" as UC29
    }
    
    package "System Management" {
        usecase "UC30: Monitor Server Health" as UC30
        usecase "UC31: View Active Sessions" as UC31
        usecase "UC32: Manage Database" as UC32
        usecase "UC33: Configure AI Services" as UC33
    }
}

' Student interactions
Student --> UC1
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC7
Student --> UC9
Student --> UC10
Student --> UC11
Student --> UC12
Student --> UC13
Student --> UC14
Student --> UC15
Student --> UC27
Student --> UC28

' Agent interactions
Agent --> UC20
Agent --> UC21
Agent --> UC22
Agent --> UC23
Agent --> UC24
Agent --> UC25

' Admin interactions
Admin --> UC29
Admin --> UC30
Admin --> UC31
Admin --> UC32
Admin --> UC33

' Use case relationships - Includes
UC1 .> UC2 : <<include>>
UC3 .> UC7 : <<include>>
UC8 .> UC20 : <<include>>
UC8 .> UC16 : <<include>>
UC10 .> UC17 : <<include>>
UC11 .> UC18 : <<include>>
UC22 .> UC23 : <<include>>
UC22 .> UC24 : <<include>>

' Use case relationships - Extends
UC5 ..> UC8 : <<extend>>\n[all ready]
UC10 ..> UC26 : <<extend>>
UC12 ..> UC22 : <<extend>>\n[agent turn]
UC8 ..> UC25 : <<extend>>\n[discussion ends]

' System interactions (automatic)
UC16 .> UC19 : <<include>>
UC21 .> UC26 : <<include>>
UC8 ..> UC31 : <<extend>>

note right of Student
    Primary user of the system
    Participates in discussions
    Receives English feedback
end note

note right of Agent
    AI-powered facilitator
    Provides real-time feedback
    Based on CEFR standards
end note

note bottom of UC20
    **Topic Generation:**
    - Uses AI API (Hugging Face)
    - Fallback to curated topics
    - Categorized by theme
end note

note bottom of UC22
    **CEFR Feedback includes:**
    - Grammar corrections
    - Vocabulary suggestions
    - Sentence structure tips
    - Pronunciation guidance
    - Overall assessment
end note

note bottom of UC16
    **WebRTC Setup:**
    - Peer-to-peer audio
    - STUN server for NAT
    - Signaling via Socket.io
    - Opus codec prioritization
end note

note right of UC8
    **Discussion Requirements:**
    - Minimum 2 participants
    - All must be ready
    - Audio permissions granted
    - Topic selected
end note

@enduml
