@startuml GupShup Cafe - LLM Agent Interaction Sequence

' Use latest PlantUML version features
!theme plain
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam participant {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}

title GupShup Cafe - AWS Strands Multi-Agent LLM Interaction (MVP)

participant "User\n(Alice)" as Alice
participant "React App" as React
participant "Socket.io\nClient" as Socket
participant "AWS Fargate\n(FastAPI)" as Backend
participant "AWS Strands\nOrchestrator" as Orchestrator
participant "EnglishFeedback\nAgent" as EnglishAgent
participant "DebateFacilitator\nAgent" as FacilitatorAgent
participant "AWS Bedrock\n(Claude 3)" as Bedrock
participant "Gemini API\n(Dev)" as Gemini
participant "Database\n(SQLite)" as DB

== Speaking Turn with Real-time Feedback ==

Alice -> React : Speaks during her turn
React -> React : Web Speech API transcribes
React -> React : Got transcript: "I thinks AI will\nreplace many jobs"

React -> Socket : emit('speech-transcript', {text, speaker})
Socket -> Backend : speech-transcript event

Backend -> DB : INSERT transcript
DB --> Backend : transcript_id

note over Backend
    Store transcript first,
    then request AI feedback
end note

Backend -> Backend : Queue for instant feedback
Backend -> Orchestrator : get_english_feedback(\n  statements=[{speaker, text}],\n  instant=True,\n  context={topic, previous_feedback}\n)

note over Orchestrator
    Instant Mode: 2-3 second response
    for real-time UI feedback
end note

Orchestrator -> Orchestrator : Extract latest statement
Orchestrator -> EnglishAgent : analyze({\n  text: "I thinks AI will replace...",\n  mode: "instant",\n  previous_feedback: [...]\n})

== Quick Grammar Analysis ==

EnglishAgent -> EnglishAgent : Detect grammar issues
EnglishAgent -> EnglishAgent : Issues found:\n- "I thinks" → "I think"

alt Production Environment
    EnglishAgent -> Bedrock : Invoke Claude 3\nwith grammar prompt
    Bedrock --> EnglishAgent : Grammar analysis result
else Development Environment
    EnglishAgent -> Gemini : Call Gemini API\nwith grammar prompt
    Gemini --> EnglishAgent : Grammar analysis result
end

EnglishAgent -> EnglishAgent : Calculate quick scores:\n- Grammar: 7/10\n- Vocabulary: 8/10\n- Fluency: 8/10

EnglishAgent -> EnglishAgent : Determine CEFR level: B1

EnglishAgent --> Orchestrator : {\n  grammar_score: 7,\n  grammar_issues: [{...}],\n  vocabulary_score: 8,\n  fluency_score: 8,\n  cefr_level: "B1",\n  overall_score: 7.7\n}

Orchestrator -> Orchestrator : _format_feedback_message(result)
Orchestrator -> Orchestrator : _format_gentle_mention(Alice, result)

Orchestrator --> Backend : {\n  feedback_type: "instant",\n  speaker: "Alice",\n  grammar: {issues: [...]},\n  cefr_level: "B1",\n  display_message: "📝 Grammar...",\n  agent_mention: "Alice, great point!..."\n}

Backend -> DB : INSERT feedback (instant)
DB --> Backend : feedback_id

Backend -> Socket : emit('english-feedback', feedback, to=Alice)
Socket -> React : 'english-feedback' event (private)

React -> React : EnglishFeedbackModal opens
React --> Alice : **English Feedback Modal**\n📝 Grammar Feedback:\n⚠ "I thinks" → "I think"\nCEFR: B1, Score: 7.7/10

note over Alice
    Feedback displayed
    privately in modal,
    2-3 seconds after speaking
end note

== Facilitator Agent Gentle Mention ==

Backend -> FacilitatorAgent : generate_gentle_response(\n  speaker: "Alice",\n  main_issue: {...}\n)

FacilitatorAgent -> Bedrock : Create conversational response
Bedrock --> FacilitatorAgent : "Alice, great point!\nQuick tip: 'I think'..."

FacilitatorAgent --> Backend : agent_response

Backend -> Backend : Optionally use TTS
Backend -> Socket : emit('agent-mention', {text, speaker})
Socket -> React : Display agent mention
React --> Alice : Agent: "Alice, great point!\nQuick tip: 'I think'..."

== Comprehensive Analysis at End ==

note over Backend
    After discussion ends
    (all 3 rounds complete)
end note

Backend -> Backend : Collect all transcripts\nfor the session
Backend -> DB : SELECT transcripts\nWHERE session_id = ?
DB --> Backend : all_statements: [...]

Backend -> Orchestrator : get_english_feedback(\n  statements=all_statements,\n  instant=False,\n  context={session_id, topic, duration}\n)

note over Orchestrator
    Comprehensive Mode:
    Detailed analysis with
    progress tracking
end note

Orchestrator -> EnglishAgent : analyze({\n  statements: [...],\n  mode: "comprehensive",\n  context: {...}\n})

== Detailed Multi-Statement Analysis ==

EnglishAgent -> EnglishAgent : Group statements by speaker
EnglishAgent -> EnglishAgent : Analyze each participant

loop For each participant
    alt Production
        EnglishAgent -> Bedrock : Comprehensive analysis\nfor all statements
        Bedrock --> EnglishAgent : Detailed feedback
    else Development
        EnglishAgent -> Gemini : Comprehensive analysis\nfor all statements
        Gemini --> EnglishAgent : Detailed feedback
    end
    
    EnglishAgent -> EnglishAgent : Track CEFR progression
    EnglishAgent -> EnglishAgent : Identify improvement areas
    EnglishAgent -> EnglishAgent : Generate recommendations
end

EnglishAgent --> Orchestrator : {\n  feedback_type: "comprehensive",\n  participants: {\n    Alice: {cefr_trajectory, ...},\n    Bob: {...}\n  },\n  progress_tracking: {...},\n  recommendations: [...]\n}

Orchestrator -> Orchestrator : _analyze_per_participant()
Orchestrator --> Backend : comprehensive_feedback

Backend -> DB : INSERT feedback\n(comprehensive, per participant)
DB --> Backend : feedback_ids

Backend -> Socket : emit('session-summary', summary)
Socket -> React : Display summary screen

React --> Alice : **Session Summary**\n- Your CEFR: B1 → B1+\n- Grammar improved\n- Recommendations: [...]

== Topic Guidance (Optional) ==

note over FacilitatorAgent
    During discussion,
    if conversation stalls
end note

Backend -> FacilitatorAgent : suggest_topic_direction(\n  statements=[...],\n  current_topic="AI and Jobs"\n)

FacilitatorAgent -> Bedrock : Generate discussion prompt
Bedrock --> FacilitatorAgent : "Let's explore how AI\nmight create new jobs..."

FacilitatorAgent --> Backend : suggestion

Backend -> Socket : emit('agent-suggestion', {text})
Socket -> React : Display suggestion
React --> Alice : Agent: "Let's explore..."

note as AgentArchitecture
    **AWS Strands Multi-Agent Architecture:**
    
    1. **Orchestrator** coordinates multiple agents:
       - Routes requests to appropriate agent
       - Manages instant vs comprehensive modes
       - Aggregates results from multiple agents
    
    2. **EnglishFeedbackAgent**:
       - Instant feedback (2-3s) during speaking
       - Comprehensive analysis after discussion
       - CEFR leveling and progress tracking
       - Grammar, vocabulary, fluency scoring
    
    3. **DebateFacilitatorAgent**:
       - Gentle conversational feedback
       - Topic guidance when needed
       - Discussion flow management
       - Participant support
    
    4. **LLM Providers** (pluggable):
       - Production: AWS Bedrock (Claude 3)
       - Development: Gemini API (free tier)
       - Abstracted via LLMInterface
    
    5. **AWS AgentCore** wrapper:
       - Provides runtime environment
       - Manages IAM permissions
       - Enables internet access for APIs
       - Handles monitoring/logging
    
    **Feedback Flow:**
    - User speaks → Transcript → Instant feedback (2-3s)
    - Discussion ends → Comprehensive analysis
    - Private feedback shown in modal
    - Agent mentions feedback conversationally
end note

@enduml
