@startuml GupShup Cafe - Discussion Lifecycle Activity Diagram

' Use latest PlantUML version features
!theme plain
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam activity {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    DiamondBackgroundColor #FFF9C4
    DiamondBorderColor #F57C00
    StartColor #388E3C
    EndColor #D32F2F
}

title GupShup Cafe - Complete Discussion Lifecycle (MVP)

start

:User opens app;

:Authenticate with Google OAuth;
note right
  Create user record if first time
  Store CEFR level (initially A0)
end note

:Navigate to Lobby Page;

if (Create New Room?) then (yes)
  :Click "Create New Room";
  :Enter room details:
  - Room name
  - Max participants (default: 3)
  - Topic category;
  :Generate or select topic;
  :User becomes HOST;
  :Publish room;
else (no)
  :View available rooms;
  :Filter by topic/CEFR (optional);
  :Select a room to join;
endif

:Enter anonymous name
(e.g., "Blue Panda");

:Request microphone permission;

if (Mic Permission Granted?) then (yes)
  :Initialize WebRTC AudioContext;
  :Connect to Socket.io server;
else (no)
  :Show error message;
  stop
endif

:Join room;

:Display in waiting area;
note right
  Room Status: WAITING
  Show other participants
end note

fork
  :Wait for other participants;
fork again
  :Check mic & audio levels;
  :Test network connection;
end fork

:Click "I'm ready to start!";

:Mark participant as ready;

if (All Participants Ready?) then (no)
  :Wait for others;
  note right: Show "2/3 ready"
else (yes)
  :Enable "Start Discussion" button;
endif

:HOST clicks "Start Discussion";

:Room status → IN_PROGRESS;

:Initialize discussion state:
- current_round = 1
- current_speaker_index = 0
- speaking_time = 60s;

partition "Discussion Rounds (3 rounds)" {
  
  repeat
    
    partition "Single Round" {
      
      :Round starts;
      note right: Announce round number
      
      repeat
        
        partition "Individual Turn" {
          
          :Select current speaker;
          
          fork
            :Display speaker in center;
            :Highlight participant card;
          fork again
            :Start 60-second timer;
          end fork
          
          :Speaker unmutes mic;
          
          fork
            :WebRTC audio streams to peers;
          fork again
            :Web Speech API transcribes;
          fork again
            :Display live transcript;
          end fork
          
          :Speaker speaks;
          note right
            Other participants hear
            via WebRTC P2P audio
          end note
          
          :Send transcript to backend;
          
          :Request instant AI feedback;
          
          :LLM analyzes (2-3 seconds):
          - Grammar check
          - Vocabulary assessment
          - Fluency evaluation
          - CEFR leveling;
          
          :Store transcript in DB;
          :Store instant feedback in DB;
          
          :Send feedback to speaker
          (private modal);
          
          fork
            :Display English Feedback Modal:
            - CEFR level
            - Grammar issues
            - Scores
            - Suggestions;
          fork again
            :Optional agent gentle mention
            in conversation;
          end fork
          
          if (Timer Expired or\nManual End?) then (yes)
            :End turn;
          else (no)
            :Continue speaking;
          endif
          
          :Mute speaker;
          
          :Move to next speaker;
          
        }
        
      repeat while (More speakers\nin round?) is (yes)
      ->no;
      
      :Round complete;
      
    }
    
    :Increment round number;
    
  repeat while (More rounds?\n(current < 3)) is (yes)
  ->no;
  
}

:Discussion complete;

:Room status → COMPLETED;

partition "Post-Discussion Analysis" {
  
  :Collect all transcripts
  from database;
  
  :Request comprehensive
  LLM analysis;
  
  :AWS Strands Orchestrator
  analyzes:
  - All statements
  - Per-participant progress
  - CEFR trajectory
  - Improvement areas;
  
  :Store comprehensive
  feedback in DB;
  
  :Generate session summary:
  - Participant stats
  - CEFR changes
  - Recommendations
  - Strengths & improvements;
  
}

:Display Session Summary;

fork
  :Show individual feedback:
  - Your CEFR progress
  - Grammar/Vocab/Fluency scores
  - Top 5 suggestions
  - Positive highlights;
fork again
  :Offer options:
  - Download transcript
  - View detailed analysis
  - Join another room;
end fork

if (User Action?) then (Join Another Room)
  :Return to Lobby;
  :Find new room;
  note right: User can immediately join another discussion
else (Leave)
  :Click "Leave Room";
  :Disconnect from Socket.io;
  :Stop WebRTC connections;
  :Clean up audio streams;
endif

:Update user profile:
- Last active timestamp
- Total sessions count
- Update CEFR level if changed;

:Save to database;

stop

note as DiscussionNotes
  **Key MVP Features:**
  
  1. **Turn-based Speaking**: 60 seconds per turn
  2. **3 Rounds**: Each participant speaks 3 times
  3. **Real-time Feedback**: 2-3 second analysis
  4. **Private Feedback**: Only speaker sees their feedback
  5. **WebRTC P2P Audio**: Direct peer connections
  6. **Comprehensive Summary**: Post-discussion analysis
  
  **Session Timing (3 participants):**
  - 3 speakers × 60s × 3 rounds = 9 minutes core
  - + Setup time (~2 min)
  - + Summary time (~1 min)
  - **Total: ~12 minutes per session**
  
  **Database Operations:**
  - INSERT: session, participants, transcripts, feedback
  - UPDATE: participant ready status, room status
  - SELECT: analytics, user progress
  
  **Socket.io Events:**
  - join-room, ready, start-discussion
  - turn-started, turn-ended
  - speech-transcript, english-feedback
  - discussion-ended, session-summary
  
  **WebRTC Events:**
  - webrtc-offer, webrtc-answer
  - webrtc-ice-candidate
  - participant-muted/unmuted
end note

@enduml
