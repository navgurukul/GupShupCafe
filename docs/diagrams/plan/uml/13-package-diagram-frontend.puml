@startuml GupShup Cafe - Frontend Package Diagram

!define PACKAGE_COLOR LightBlue
!define SUB_PACKAGE_COLOR LightGreen

skinparam backgroundColor #FFFFFF
skinparam packageBackgroundColor PACKAGE_COLOR
skinparam packageBorderColor DarkBlue

title GupShup Cafe - Frontend Package Structure (React + Vite)

package "client/" {
  
  package "public/" {
    artifact "index.html" as html
    artifact "favicon.ico" as favicon
    artifact "assets/" as publicAssets
  }
  
  package "src/" {
    
    package "main.jsx" {
      artifact "Root Component" as root
      artifact "Provider Wrappers" as providers
      artifact "Router Setup" as router
    }
    
    package "contexts/" <<SUB_PACKAGE_COLOR>> {
      artifact "AuthContext.jsx" as authCtx {
        + user: User
        + isAuthenticated: bool
        + login()
        + logout()
      }
      
      artifact "SocketContext.jsx" as socketCtx {
        + socket: Socket
        + connected: bool
        + roomState: RoomState
        + emit()
        + on()
      }
      
      artifact "AudioContext.jsx" as audioCtx {
        + localStream: MediaStream
        + remoteStreams: Map
        + peerConnections: Map
        + isMuted: bool
        + initializeAudio()
        + createPeerConnection()
        + toggleMute()
      }
      
      note right of audioCtx
        **WebRTC Management:**
        - Handles getUserMedia()
        - Creates RTCPeerConnection
        - Manages ICE candidates
        - Opus codec priority
        - Echo cancellation
        - STUN server config
      end note
    }
    
    package "pages/" <<SUB_PACKAGE_COLOR>> {
      artifact "LoginPage.jsx" as loginPage {
        - Google OAuth
        - Create user profile
        - Redirect to lobby
      }
      
      artifact "LobbyPage.jsx" as lobbyPage {
        - View available rooms
        - Create new room
        - Join existing room
        - Room configuration
      }
      
      artifact "RoundtablePage.jsx" as roundtablePage {
        - Main discussion UI
        - Circular table view
        - Timer management
        - Audio controls
        - Feedback display
      }
      
      note right of roundtablePage
        **Core Discussion Page:**
        - RoundtableView component
        - SpeakerTimer
        - TopicDisplay
        - EnglishFeedbackModal
        - SpeechToTextPanel
        - ParticipantCards
      end note
    }
    
    package "components/" <<SUB_PACKAGE_COLOR>> {
      
      package "ui/" {
        artifact "RoundtableView.jsx" as roundtableView
        artifact "ParticipantCard.jsx" as participantCard
        artifact "SpeakerTimer.jsx" as speakerTimer
        artifact "TopicDisplay.jsx" as topicDisplay
        artifact "AudioLevelBar.jsx" as audioLevelBar
      }
      
      package "feedback/" {
        artifact "EnglishFeedbackModal.jsx" as feedbackModal {
          + feedback: Feedback
          + isOpen: bool
          - Display CEFR badge
          - Show grammar issues
          - Show scores
          - Auto-dismiss (10s)
        }
        
        artifact "SpeechToTextPanel.jsx" as sttPanel {
          + transcript: string
          + isListening: bool
          - Live transcription
          - Copy to clipboard
        }
        
        note right of feedbackModal
          **Private Feedback:**
          - Only visible to speaker
          - Real-time (2-3s delay)
          - Non-blocking position
          - Grammar corrections
          - CEFR level display
          - Vocabulary/Fluency scores
        end note
      }
      
      package "common/" {
        artifact "ProtectedRoute.jsx" as protectedRoute
        artifact "LoadingSpinner.jsx" as loadingSpinner
        artifact "ErrorBoundary.jsx" as errorBoundary
        artifact "Button.jsx" as button
        artifact "Modal.jsx" as modal
      }
      
      note right of common
        **Reusable Components:**
        - Authentication guards
        - Loading states
        - Error handling
        - UI primitives
      end note
    }
    
    package "hooks/" <<SUB_PACKAGE_COLOR>> {
      artifact "useAuth.js" as useAuth {
        + user: User
        + login()
        + logout()
        + isAuthenticated
      }
      
      artifact "useSocket.js" as useSocket {
        + socket: Socket
        + emit()
        + on()
        + connected
      }
      
      artifact "useAudio.js" as useAudio {
        + localStream
        + remoteStreams
        + toggleMute()
        + initializeAudio()
      }
      
      artifact "useRoomState.js" as useRoomState {
        + roomState
        + participants
        + currentSpeaker
        + updateRoomState()
      }
      
      note right of hooks
        **Custom Hooks:**
        - Abstract context logic
        - Reusable state management
        - Side effect handling
        - Simplify component code
      end note
    }
    
    package "services/" <<SUB_PACKAGE_COLOR>> {
      artifact "api.js" as apiService {
        + get()
        + post()
        + fetchTopics()
        + fetchAnalytics()
        - Base URL config
        - Error handling
      }
      
      artifact "webrtc.js" as webrtcService {
        + createPeerConnection()
        + handleOffer()
        + handleAnswer()
        + handleICECandidate()
        - STUN configuration
        - Codec preferences
      }
      
      artifact "speech.js" as speechService {
        + startRecognition()
        + stopRecognition()
        - Web Speech API wrapper
        - Language detection
      }
    }
    
    package "types/" <<SUB_PACKAGE_COLOR>> {
      artifact "User.ts" as userType
      artifact "Participant.ts" as participantType
      artifact "RoomState.ts" as roomStateType
      artifact "Feedback.ts" as feedbackType
      artifact "Transcript.ts" as transcriptType
      
      note right of types
        **TypeScript Definitions:**
        - Type safety
        - Intellisense support
        - Shared interfaces
        - API contract validation
      end note
    }
    
    package "utils/" <<SUB_PACKAGE_COLOR>> {
      artifact "constants.js" as constants
      artifact "helpers.js" as helpers
      artifact "formatters.js" as formatters
      artifact "validators.js" as validators
    }
    
    package "styles/" <<SUB_PACKAGE_COLOR>> {
      artifact "index.css" as globalStyles
      artifact "tailwind.config.js" as tailwindConfig
      note right
        Tailwind CSS for styling
        Component-scoped styles
      end note
    }
  }
  
  package "Configuration Files" {
    artifact "vite.config.js" as viteConfig
    artifact "package.json" as packageJson
    artifact ".env" as envFile
    artifact "tsconfig.json" as tsconfigJson
  }
  
  package "Build Output (dist/)" {
    artifact "Compiled Assets" as dist
  }
}

