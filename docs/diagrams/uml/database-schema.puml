' Analytics queries
note as AnalyticsQueries
  **Common Analytics Queries:**
  
  1. Total sessions:
     SELECT COUNT(*) FROM sessions
  
  2. Average session duration:
     SELECT AVG(duration_seconds) FROM sessions
     WHERE duration_seconds > 0
  
  3. Most popular topics:
     SELECT title, category, used_count
     FROM topics
     ORDER BY used_count DESC
     LIMIT 10
  
  4. Unique participants:
     SELECT COUNT(DISTINCT user_id)
     FROM participants
  
  5. Session with participants:
     SELECT s.*, COUNT(p.id) as participant_count
     FROM sessions s
     LEFT JOIN participants p ON s.id = p.session_id
     GROUP BY s.id
  
  6. Average participants per session:
     SELECT AVG(participant_count) FROM sessions
  
  7. Category distribution:
     SELECT category, COUNT(*) as count
     FROM topics
     WHERE used_count > 0
     GROUP BY category
end note

@enduml
