@startuml Component Diagram - GupShup Cafe Architecture

!define RECTANGLE class

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam handwritten false

title GupShup Cafe - Component Diagram (server_py Backend)

package "Client Layer (Browser)" as ClientLayer {
    component [React Application] as ReactApp {
        component [Login Page] as LoginPage
        component [Lobby Page] as LobbyPage
        component [Roundtable Page] as RoundtablePage
        component [Audio Test Page] as AudioTestPage
    }
    
    component [Context Providers] as Contexts {
        component [Auth Context] as AuthCtx
        component [Socket Context] as SocketCtx
        component [Audio Context] as AudioCtx
    }
    
    component [WebRTC Engine] as WebRTC
}

package "Communication Layer" as CommLayer {
    interface "HTTPS/REST" as REST
    interface "WebSocket (Socket.io)" as WS
    interface "WebRTC (STUN/TURN)" as RTC
}

package "Server Layer (Python - server_py)" as ServerLayer {
    component [FastAPI Application] as FastAPI {
        component [CORS Middleware] as CORS
        component [API Router] as APIRouter
    }
    
    component [Socket.io Server] as SocketIO {
        component [Socket Handlers] as SocketHandlers
        component [WebRTC Signaling] as WebRTCSignaling
    }
    
    component [Room Manager] as RoomManager {
        component [Participant Tracking] as ParticipantTracker
        component [Discussion State] as DiscussionState
        component [Timer Management] as TimerMgmt
    }
    
    component [LLM Tutor Service] as LLMTutor {
        component [Debate Room Facilitator] as Facilitator
        component [Gemini Agent] as GeminiAgent
        component [MCP Client] as MCPClient
    }
    
    component [AI Services] as AIServices {
        component [Topic Generator] as TopicGen
    }
    
    component [Database Service] as DBService {
        component [Session Operations] as SessionOps
        component [Participant Operations] as ParticipantOps
        component [Analytics Operations] as AnalyticsOps
    }
}

package "Data Layer" as DataLayer {
    database "SQLite Database" as SQLite {
        storage "sessions" as SessionsTable
        storage "participants" as ParticipantsTable
        storage "topics" as TopicsTable
    }
    
    cloud "External AI Services" as ExternalAI {
        component [AWS Strands] as Strands
        component [Google Gemini] as Gemini
        component [AWS Bedrock] as Bedrock
        component [Hugging Face] as HuggingFace
    }
    
    cloud "MCP Server" as MCPServer {
        component [Calculator Tools] as CalcTools
        component [Debate Tools] as DebateTools
    }
}

' Client to Communication Layer connections
ReactApp -down-> REST : "API Requests"
SocketCtx -down-> WS : "Real-time Events"
WebRTC -down-> RTC : "Audio Streams"

' Communication Layer to Server connections
REST -down-> FastAPI : "HTTP/HTTPS"
WS -down-> SocketIO : "WebSocket"
RTC ..> SocketIO : "Signaling"

' Internal Server connections
FastAPI -down-> APIRouter
SocketIO -down-> SocketHandlers
SocketHandlers -right-> RoomManager : "manages"
SocketHandlers --> WebRTCSignaling : "uses"

APIRouter --> AIServices : "uses"
APIRouter --> DBService : "uses"
APIRouter --> RoomManager : "queries"

RoomManager --> ParticipantTracker
RoomManager --> DiscussionState
RoomManager --> TimerMgmt

SocketHandlers --> LLMTutor : "uses"
LLMTutor --> Facilitator
Facilitator --> GeminiAgent
Facilitator --> MCPClient

AIServices --> TopicGen

' Server to Data Layer connections
DBService -down-> SQLite
TopicGen -down-> ExternalAI : "API Calls"
GeminiAgent -down-> ExternalAI : "LLM Calls"
MCPClient -down-> MCPServer : "HTTP/Streamable"

DBService --> SessionOps
DBService --> ParticipantOps
DBService --> AnalyticsOps

SessionOps --> SessionsTable
ParticipantOps --> ParticipantsTable
AnalyticsOps --> TopicsTable

note right of LLMTutor
  Provides CEFR-based
  English language feedback
  and facilitates discussions
end note

note right of RoomManager
  In-memory state management
  for active discussions
end note

note left of ExternalAI
  Development: Strands + Gemini
  Production: Bedrock Models
end note

note bottom of MCPServer
  MCP (Model Context Protocol)
  Server for tool execution
  via Streamable HTTP
end note

@enduml
