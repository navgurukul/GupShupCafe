[Unit]
Description=AI Roundtable FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/GupShupCafe/server_py
Environment="PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 -m uvicorn main:socket_app --host 0.0.0.0 --port 3003
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
