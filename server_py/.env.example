# Server Configuration
PORT=3003
PYTHON_ENV=development

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
DATABASE_URL=./data/roundtable.db

# AI Configuration (Hugging Face)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# LLM Agent Configuration
# Set to 'true' to enable AI Tutor as a default participant in discussions
ENABLE_LLM_AGENT=false

# Multi-Agent System Configuration
# Set to 'true' to enable multi-agent architecture (separate English and Facilitator agents)
USE_MULTI_AGENT=true

# Gemini API Configuration (required for multi-agent system)
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Bedrock AgentCore Configuration (optional - for production deployment)
# Set to 'true' to deploy agents to AWS Bedrock AgentCore
USE_AWS_AGENTCORE=false
AWS_REGION=us-east-1
# AWS credentials (not needed if using IAM roles on EC2)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Discussion Settings
DEFAULT_SPEAKING_TIME=60
MIN_PARTICIPANTS=1
MAX_PARTICIPANTS=8

# Session Settings
SESSION_TIMEOUT=3600000
